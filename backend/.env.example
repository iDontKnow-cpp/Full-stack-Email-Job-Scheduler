# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://scheduler:scheduler123@localhost:5432/email_scheduler

# Redis (BullMQ and Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# Google OAuth 2.0 (Google Cloud Console Credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# JWT & Session Authentication
JWT_SECRET=your-jwt-secret-change-in-production-super-secure-key
JWT_EXPIRES_IN=7d
SESSION_SECRET=your-session-secret-change-in-production

# Ethereal Email SMTP Credentials (Optional - auto-creates an account if left blank)
ETHEREAL_USER=
ETHEREAL_PASS=

# BullMQ Queue & Worker Concurrency Configuration
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000

# Hourly Rate Limiting (Per-Sender Window)
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Elasticsearch Search Engine
ELASTICSEARCH_URL=http://localhost:9200

# Slack OAuth v2 App Credentials (For Rate Limit Hit Alerts)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:3001/api/slack/callback
