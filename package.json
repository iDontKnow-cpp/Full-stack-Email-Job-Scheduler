{
  "name": "fullstack-email-job-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade distributed email scheduler service and dashboard",
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:start": "npm --prefix backend run start",
    "backend:db:push": "npm --prefix backend run db:push",
    "backend:db:seed": "npm --prefix backend run db:seed",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:preview": "npm --prefix frontend run preview",
    "docker:build:backend": "docker build -t email-scheduler-backend:latest ./backend",
    "docker:build:frontend": "docker build -t email-scheduler-frontend:latest ./frontend",
    "docker:build": "npm run docker:build:backend && npm run docker:build:frontend",
    "k8s:apply": "kubectl apply -k k8s/",
    "k8s:delete": "kubectl delete -k k8s/",
    "k8s:status": "kubectl get all,hpa,pvc,ingress -n email-scheduler",
    "k8s:logs:backend": "kubectl logs -n email-scheduler -l app=backend -f",
    "k8s:logs:frontend": "kubectl logs -n email-scheduler -l app=frontend -f",
    "build": "npm --prefix backend run build && npm --prefix frontend run build"
  },
  "keywords": [
    "email-scheduler",
    "bullmq",
    "redis",
    "postgresql",
    "prisma",
    "elasticsearch",
    "react",
    "typescript",
    "express"
  ],
  "author": "",
  "license": "MIT"
}

